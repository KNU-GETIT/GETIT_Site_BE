# Coding_Convention.pdf 3. 포맷팅 및 스타일
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 2
max_line_length = 120

[*.{yml,yaml,json}]
indent_size = 2

[*.{gradle,properties}]
indent_size = 2

[Makefile]
indent_style = tab
